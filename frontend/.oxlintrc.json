{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "unicorn",
    "oxc",
    "react",
    "react_perf",
    "import",
    "promise",
    "vitest"
  ],
  "ignorePatterns": [
    "**/node_modules/**",
    "**/routeTree.gen.ts",
    "**/model/generated/**",
    "dist/**",
    "coverage/**"
  ],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "no-nested-ternary": "error",
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "group": ["@/features/*/**"],
            "caseSensitive": true,
            "message": "Do not import feature internals. Import from '@/features/<feature>'."
          },
          {
            "group": ["@/model/*/**", "!@/model/generated/**"],
            "caseSensitive": true,
            "message": "Do not import model internals. Import from '@/model/<module>'."
          }
        ]
      }
    ],
    "typescript/consistent-type-imports": [
      "warn",
      { "disallowTypeAnnotations": false }
    ],
    "typescript/prefer-as-const": "error",
    "typescript/prefer-optional-chain": "warn",
    "typescript/prefer-for-of": "warn",

    "unicorn/prefer-at": "warn",
    "unicorn/prefer-structured-clone": "warn",
    "unicorn/prefer-object-from-entries": "warn",
    "unicorn/prefer-optional-catch-binding": "warn",
    "unicorn/prefer-node-protocol": "warn",
    "unicorn/prefer-string-starts-ends-with": "warn",
    "unicorn/no-useless-spread": "warn",
    "unicorn/no-useless-promise-resolve-reject": "warn",

    "react/jsx-no-useless-fragment": "warn",
    "react/self-closing-comp": "warn",
    "react/jsx-boolean-value": ["warn", "never"],
    "react/jsx-curly-brace-presence": [
      "warn",
      { "props": "never", "children": "never" }
    ],
    "react/no-unstable-nested-components": "error",
    "react/button-has-type": "warn",
    "react/no-array-index-key": "warn",
    "react-hooks/rules-of-hooks": "error",
    "react-hooks/exhaustive-deps": "warn",

    "promise/prefer-await-to-then": "warn",
    "promise/catch-or-return": "warn",

    "import/no-duplicates": "warn",
    "import/no-self-import": "error",

    "vitest/no-focused-tests": "error",
    "vitest/no-identical-title": "error",
    "vitest/no-conditional-expect": "warn",
    "vitest/no-disabled-tests": "warn"
  },
  "overrides": [
    {
      "files": ["src/model/**/*.ts", "src/model/**/*.tsx"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@/features/*/**"],
                "caseSensitive": true,
                "message": "Do not import feature internals. Import from '@/features/<feature>'."
              },
              {
                "group": ["@/model/*/**", "!@/model/generated/**"],
                "caseSensitive": true,
                "message": "Do not import model internals. Import from '@/model/<module>'."
              },
              {
                "regex": "^@/(?:app|pages|features|components|hooks)(?:/|$)",
                "message": "Model modules may not depend on app, pages, features, components, or hooks."
              }
            ]
          }
        ],
        "no-restricted-properties": [
          "error",
          {
            "object": "document",
            "message": "Model modules must not access the document; move browser effects to the UI layer."
          },
          {
            "object": "window",
            "allowProperties": [
              "localStorage",
              "addEventListener",
              "removeEventListener"
            ],
            "message": "Model modules may only use window for storage synchronization; move other browser effects to the UI layer."
          }
        ]
      }
    },
    {
      "files": ["src/features/**/*.ts", "src/features/**/*.tsx"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@/features/*/**"],
                "caseSensitive": true,
                "message": "Do not import feature internals. Import from '@/features/<feature>'."
              },
              {
                "group": ["@/model/*/**", "!@/model/generated/**"],
                "caseSensitive": true,
                "message": "Do not import model internals. Import from '@/model/<module>'."
              },
              {
                "regex": "^@/(?:app|pages)(?:/|$)",
                "message": "Feature modules may not depend on app or pages."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "src/components/**/*.ts",
        "src/components/**/*.tsx",
        "src/hooks/**/*.ts",
        "src/hooks/**/*.tsx",
        "src/lib/**/*.ts",
        "src/lib/**/*.tsx",
        "src/config/**/*.ts",
        "src/config/**/*.tsx",
        "src/i18n/**/*.ts",
        "src/i18n/**/*.tsx"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@/features/*/**"],
                "caseSensitive": true,
                "message": "Do not import feature internals. Import from '@/features/<feature>'."
              },
              {
                "group": ["@/model/*/**", "!@/model/generated/**"],
                "caseSensitive": true,
                "message": "Do not import model internals. Import from '@/model/<module>'."
              },
              {
                "regex": "^@/(?:app|pages|features)(?:/|$)",
                "message": "Shared modules may not depend on app, pages, or features."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/pages/**/*.ts", "src/pages/**/*.tsx"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@/features/*/**"],
                "caseSensitive": true,
                "message": "Do not import feature internals. Import from '@/features/<feature>'."
              },
              {
                "group": ["@/model/*/**", "!@/model/generated/**"],
                "caseSensitive": true,
                "message": "Do not import model internals. Import from '@/model/<module>'."
              },
              {
                "regex": "^@/app(?:/|$)",
                "message": "Pages may not depend on the app composition layer."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "**/*.test.ts",
        "**/*.test.tsx",
        "**/*.spec.ts",
        "**/*.spec.tsx"
      ],
      "rules": {
        "vitest/require-mock-type-parameters": "off",
        "vitest/no-standalone-expect": "off",
        "vitest/require-to-throw-message": "off",
        "react_perf/jsx-no-new-object-as-prop": "off",
        "react_perf/jsx-no-new-array-as-prop": "off",
        "react_perf/jsx-no-new-function-as-prop": "off",
        "react_perf/jsx-no-jsx-as-prop": "off"
      }
    }
  ],
  "env": {
    "builtin": true
  }
}
