{
  "name": "frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "api:generate": "go -C ../core-api run ./cmd/openapi -output ../openapi/openapi.json && openapi-typescript ../openapi/openapi.json -o src/model/generated/core-api.ts",
    "api:check": "pnpm api:generate && tsc -p tsconfig.api.json",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "pnpm test:coverage:report && pnpm coverage:check",
    "test:coverage:report": "vitest run --coverage",
    "coverage:check": "node scripts/check-coverage.mjs",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@mantine/hooks": "^9.5.1",
    "@tanstack/react-form": "^1.33.2",
    "@tanstack/react-query": "^5.101.2",
    "@tanstack/react-router": "^1.170.18",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fast-deep-equal": "3.1.3",
    "i18next": "^26.3.6",
    "lucide-react": "^1.25.0",
    "openapi-fetch": "^0.17.0",
    "pixi-viewport": "^6.0.3",
    "pixi.js": "^8.19.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-dropzone": "^19.1.1",
    "react-i18next": "^17.0.11",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3",
    "zundo": "^2.3.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@mdx-js/rollup": "^3.1.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/router-plugin": "^1.168.23",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.10",
    "happy-dom": "^20.11.2",
    "openapi-typescript": "7.13.0",
    "oxfmt": "^0.59.0",
    "oxlint": "^1.71.0",
    "rehype-slug": "^6.0.0",
    "shadcn": "^4.13.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@11.5.0"
}
